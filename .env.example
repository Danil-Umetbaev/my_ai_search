# Copy to .env. Replace POSTGRES_PASSWORD before publishing.
POSTGRES_DB=my_ai_search
POSTGRES_USER=search
POSTGRES_PASSWORD=change-me-before-publishing
HTTP_PORT=8080
BIND_ADDRESS=0.0.0.0
RELEASE_TAG=latest
LLM_MODEL_NAME=Qwen/Qwen3.5-4B
LLM_LOAD_IN_4BIT=true
LLM_ANSWER_MODE=extractive

# Optional VK notifications. Leave disabled for the public MVP.
VK_TOKEN=
VK_PEER_ID=0
VK_GROUP_ID=0
VK_API_VERSION=5.199

# Optional: reuse an existing Docker model cache (for example backend_hf_cache).
# HF_CACHE_VOLUME=backend_hf_cache
# HF_CACHE_EXTERNAL=true
# Enable only after all three models have been downloaded:
# HF_HUB_OFFLINE=1


JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_TRUSTED_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173"]
AUTH_COOKIE_SECURE=false
LOAD_SEARCH_MODELS=true
SUPPORT_MODEL_TIMEOUT_SECONDS=45
HF_TOKEN=
HF_XET_HIGH_PERFORMANCE=1
