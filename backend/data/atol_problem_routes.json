{
  "version": 1,
  "other_models": ["вики|пирит|эвотор|viki|pirit|evotor", "атол\\s*(?!22птк)\\d+(?![\\d])"],
  "corrections": {
    "бамага": "бумага", "бамаги": "бумаги", "бумга": "бумага",
    "пичатает": "печатает", "печатеат": "печатает", "печтает": "печатает",
    "заживало": "зажевало", "зажовало": "зажевало", "кампьютер": "компьютер"
  },
  "unsupported": ["вики|пирит|эвотор", "атол\\s*(?!fprint|фпринт|22птк)\\d+(?![\\d])", "\\bqr\\b|куар|кьюар", "не (?:зажев|замя|застря|перегре|пропада|мига)", "не пуст|не блед|не закрыт", "бумаг[аи] не законч", "не .*а (?:теперь|сейчас)", "раньше|больше не|уже (?:исправ|работает|печатает)|перестал[аи]? (?:зажев|мига|замин)", "как (?:избежать|предотвратить)|что такое"],
  "problems": [
    {"target": "button", "patterns": ["кнопк.*(?:не работа|не реаг|не нажим)", "(?:не работа|не реаг).*кнопк", "нажат.*(?:ничего|нет реакц)"]},
    {"target": "date_lock", "patterns": ["дат.*блокир|блокир.*дат"]},
    {"target": "fn", "patterns": ["(?:фн|накопител).*?(?:заполн|замен|ресурс.*исчерп)|(?:замен|заполн).*?(?:фн|накопител)"]},
    {"target": "ofd_lock", "patterns": ["(?:офд.*блокир|блокир.*офд)"]},
    {"target": "commands", "patterns": ["(?:касса|ккт).*не выполня.*(?:операц|команд)"]},
    {"target": "pc", "patterns": ["(?:программ|компьютер|драйвер|пк).*не (?:видит|находит|обнаруж).*касс", "касс.*не (?:отвечает|подключается).*?(?:программ|компьютер|пк)", "нет связи с касс"]},
    {"target": "fn_closed", "patterns": ["(?:фн|накопител).*закрыт"]},
    {"target": "paper", "patterns": ["нет бумаг|бумаг[аи] нет|(?:бумаг|лент).*законч|законч.*(?:бумаг|лент)|заменить (?:бумаг|лент)|заправить (?:бумаг|лент)|вставить рулон"], "exclude": ["нет бумаг.*не (?:пишет|показывает|горит)"]},
    {"target": "overflow", "patterns": ["переполн.*(?:буфер|эж)|буфер.*переполн"]},
    {"target": "shift", "patterns": ["снятие отчет.*прерва|отчет.*прервал"]},
    {"target": "license", "patterns": ["лицензи.*(?:истек|законч|ошиб)|(?:истек|законч).*лицензи"]},
    {"target": "dots", "patterns": ["пропада.*точк|точк.*пропада|пропуск.*точк"]},
    {"target": "blank", "patterns": ["пуст(?:ой|ые|ая).*?(?:чек|бумаг|лент)|(?:чек|бумаг|лент).*пуст", "(?:бумаг|лент).*?(?:без печати|без текста|чистая)|белый чек"]},
    {"target": "cover", "patterns": ["зелен.*горит.*красн.*мига|красн.*мига.*зелен.*горит"]},
    {"target": "selftest", "patterns": ["(?:два|2).*красн.*(?:два|2).*зелен", "красн.*(?:два|2).*зелен.*(?:два|2)"]},
    {"target": "interface", "patterns": ["(?:выключен|отключен).*интерфейс|интерфейс.*(?:выключен|отключен)"]},
    {"target": "heat", "patterns": ["перегрев|перегрел|темный след|сильно греется"]},
    {"target": "date", "patterns": ["(?:неверн|неправильн|ошиб).*?(?:дат|врем)|(?:дат|врем).*?(?:неверн|неправильн)"], "exclude": ["блокир"]},
    {"target": "fn_link", "patterns": ["нет транспортного соединения|транспорт.*соедин.*фн|фн.*транспорт.*соедин"]},
    {"target": "ofd", "patterns": ["офд.*не (?:подтверждает|принимает)|нет ответ.*офд|(?:чек|данн).*не (?:уход|отправ|доход).*офд"], "exclude": ["блокир"]},
    {"target": "jam", "patterns": ["(?:зажев|замя|застря|зажал).*?(?:бумаг|лент)|(?:бумаг|лент).*?(?:зажев|замя|застря|зажал)"]}
  ],
  "groups": [
    {"target": "group_print", "patterns": ["не печата|бледн.*(?:чек|печать)|(?:чек|печать).*бледн|бумаг.*не (?:выход|движ)|полос.*чек|чек.*полос"]},
    {"target": "group_response", "patterns": ["касс.*не реаг|касс.*завис|завис.*касс"]},
    {"target": "group_errors", "patterns": ["(?:ошибка|код ошибки)\\s*[:№]?\\s*\\d+"]},
    {"target": "group_indicators", "patterns": ["(?:лампочк|индикатор).*?(?:горит|мига)|(?:горит|мига).*?(?:лампочк|индикатор)"]}
  ]
}
